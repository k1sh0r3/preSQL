{
  "name": "@k1sh0r3/presql",
  "version": "0.1.0",
  "description": "PreSQL — a seatbelt for AI-generated SQL. An MCP server that validates queries pre-execution.",
  "main": "./dist/src/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run build && node --test dist/tests/*.test.js",
    "build": "rm -rf dist && tsc && mkdir -p dist/src && cp -r src/vendor/. dist/src/vendor/",
    "start": "node dist/src/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sql",
    "validation",
    "ai-agents",
    "safety",
    "guardrails"
  ],
  "author": "Siva Kishore Reddy Allu",
  "license": "MIT",
  "bin": {
    "presql": "./dist/src/index.js"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
